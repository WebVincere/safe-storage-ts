
{
  "name": "@webvincere/safe-storage-ts",
  "version": "1.0.1",
  "description": "Type-safe localStorage and sessionStorage wrapper for TypeScript with SSR-safe in-memory fallback, TTL expiration, and zero dependencies.",
  "author": "WebVincere",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebVincere/safe-storage-ts.git"
  },
  "homepage": "https://github.com/webvincere/safe-storage-ts#readme",
  "bugs": {
    "url": "https://github.com/webvincere/safe-storage-ts/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "localStorage",
    "sessionStorage",
    "typescript",
    "type-safe",
    "browser-storage",
    "ssr",
    "ssr-safe",
    "server-side-rendering",
    "storage",
    "ttl",
    "expiration",
    "in-memory",
    "fallback",
    "zero-dependencies"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}

{
  "name": "@webvincere/safe-storage-ts",
  "version": "1.0.3",
  "description": "Type-safe localStorage and sessionStorage wrapper for TypeScript with SSR-safe in-memory fallback, TTL expiration, and zero dependencies.",
  "author": "WebVincere",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebVincere/safe-storage-ts.git"
  },
  "homepage": "https://github.com/webvincere/safe-storage-ts#readme",
  "bugs": {
    "url": "https://github.com/webvincere/safe-storage-ts/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --format cjs --dts --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "localStorage",
    "sessionStorage",
    "typescript",
    "type-safe",
    "browser-storage",
    "ssr",
    "ssr-safe",
    "server-side-rendering",
    "storage",
    "ttl",
    "expiration",
    "in-memory",
    "fallback",
    "zero-dependencies"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
